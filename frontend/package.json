{
  "name": "azurpilot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "node mock/server.mjs --dev",
    "mock": "node mock/server.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "test:e2e:stock": "playwright test --config playwright.stock.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:fleet": "playwright test --config playwright.fleet.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@types/katex": "^0.16.8",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "echarts": "6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.45.0",
    "marked": "^18.0.14",
    "motion": "^13.4.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "^8.20.0",
    "jsdom": "28.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.0",
    "ws": "^8.21.3"
  }
}
