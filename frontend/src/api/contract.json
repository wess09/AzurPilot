    "statistics.report": {
      "mutates": false,
      "params": {
        "additionalProperties": false,
        "properties": {
          "instance": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Instance",
            "type": "string"
          },
          "category": {
            "default": "resources",
            "enum": [
              "resources",
              "action",
              "opsi",
              "commission",
              "ships",
              "loot",
              "research"
            ],
            "title": "Category",
            "type": "string"
          },
          "month": {
            "anyOf": [
              {
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Month"
          },
          "days": {
            "default": 7,
            "maximum": 365,
            "minimum": 1,
            "title": "Days",
            "type": "integer"
          },
          "period": {
            "default": "month",
            "enum": [
              "day",
              "week",
              "month"
            ],
            "title": "Period",
            "type": "string"
          },
          "series": {
            "default": 0,
            "maximum": 20,
            "minimum": 0,
            "title": "Series",
            "type": "integer"
          },
          "scope": {
            "default": "series",
            "enum": [
              "series",
              "consumable"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "instance"
        ],
        "title": "StatisticsReportParams",
        "type": "object"
      }
    },
