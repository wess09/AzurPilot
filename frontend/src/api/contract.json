              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Revision"
          },
          "changes": {
            "items": {
              "$ref": "#/$defs/ConfigChange"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Changes",
            "type": "array"
          }
        },
        "required": [
          "instance",
          "changes"
