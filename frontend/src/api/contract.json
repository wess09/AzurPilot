    "config.patch": {
      "mutates": true,
      "params": {
        "$defs": {
          "ConfigChange": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "maxLength": 180,
                "minLength": 1,
                "title": "Path",
                "type": "string"
              },
              "value": {
                "title": "Value"
              }
            },
            "required": [
              "path",
              "value"
            ],
            "title": "ConfigChange",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "instance": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Instance",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "maxLength": 64,
