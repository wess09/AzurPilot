/* AzurPilot TUI 现代化深色主题与网格样式 */

Screen {
    background: #090d13;
    color: #e6edf3;
}

#main-layout {
    width: 100%;
    height: 100%;
}

#content-pane {
    height: 100%;
    width: 1fr;
    padding: 0 1;
}

/* 按钮与交互控件微调 */
Button {
    min-width: 12;
    height: 3;
}

Button:focus {
    text-style: bold underline;
}

Button:disabled {
    opacity: 0.45;
}

Footer {
    background: #0d1117;
    color: #8b949e;
}

DataTable {
    background: #12171f;
    color: #c9d1d9;
}

DataTable > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1c2430;
}

/* 日志外框由 LogView 提供，RichLog 本身不再画边框，避免出现双层框。 */
RichLog {
    background: #090d13;
    border: none;
}

RichLog:focus {
    border: none;
}

OptionList {
    background: #12171f;
    color: #c9d1d9;
}

OptionList > .option-list--option-highlighted {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

Input,
TextArea {
    background: #0d1117;
    border: tall #30363d;
}

Input:focus,
TextArea:focus {
    border: tall #58a6ff;
}

/* Select 的边框画在内部的 SelectCurrent 上，直接给 Select 加边框会双层。 */
Select {
    background: #0d1117;
}

Select > SelectCurrent {
    background: #0d1117;
    border: tall #30363d;
}

Select:focus > SelectCurrent {
    background: #0d1117;
    border: tall #58a6ff;
}

Switch:focus > .switch--slider {
    color: #58a6ff;
}
